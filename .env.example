# ==============================================================================
# PACT Environment Configuration
# ==============================================================================

ENVIRONMENT=development
PORT=8000
LOG_LEVEL=info

# PostgreSQL 16 Database
DATABASE_URL=postgresql://pactuser:pactpassword@localhost:5432/pact_dev
TEST_DATABASE_URL=postgresql://pactuser:pactpassword@localhost:5432/pact_test

# Auth & Session Security (change in production, min 32 chars)
APP_SECRET=pact-dev-secret-key-change-in-production-min32chars
SESSION_COOKIE_NAME=pact_session
SESSION_MAX_AGE_DAYS=7
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
OTP_MODE=dev
DEV_OTP=123456

# CORS / Frontend URL
FRONTEND_URL=http://localhost:3000
EXTRA_ORIGINS=http://127.0.0.1:3000

# Collective Cycle Clock
BUSINESS_TZ=Asia/Kolkata
CYCLE_CUTOFF_DAY=22
CYCLE_CUTOFF_HOUR=17
CYCLE_CUTOFF_MINUTE=27

# Payments (mock | razorpay)
PAYMENT_GATEWAY=mock
RAZORPAY_KEY_ID=rzp_test_pactmock
RAZORPAY_KEY_SECRET=rzp_test_secret_pactmock
RAZORPAY_WEBHOOK_SECRET=pact_webhook_secret_dev

# Frontend Vite API Base URL (empty uses Vite proxy in dev; set Render API URL in prod)
VITE_API_BASE_URL=
