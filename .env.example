# ==============================================================================
# PACT - Environment Configuration Reference (.env.example)
# Copy this file to .env and configure for your local or production environment.
# ==============================================================================

# General Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
PROJECT_NAME="PACT API"
API_PREFIX=/api/v1

# ------------------------------------------------------------------------------
# 1. DATABASE (PostgreSQL 16)
# ------------------------------------------------------------------------------
# Local Docker Compose fallback:
DATABASE_URL=postgresql+psycopg://pactuser:pactpassword@localhost:5432/pact_dev
TEST_DATABASE_URL=postgresql+psycopg://pactuser:pactpassword@localhost:5432/pact_test

# ------------------------------------------------------------------------------
# 2. EVENT STREAMING (Apache Kafka)
# ------------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
EVENT_TRANSPORT=inline

# ------------------------------------------------------------------------------
# 3. BACKEND SECURITY & AUTH
# ------------------------------------------------------------------------------
APP_SECRET=pact-dev-secret-key-change-in-production-min32chars
SESSION_COOKIE_NAME=pact_session
SESSION_MAX_AGE_DAYS=7
OTP_MODE=dev

# ------------------------------------------------------------------------------
# 4. CORS & FRONTEND CLIENT
# ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
EXTRA_ORIGINS="http://127.0.0.1:3000"
NEXT_PUBLIC_API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 5. CYCLE CUTOFF CLOCK
# ------------------------------------------------------------------------------
BUSINESS_TZ=Asia/Kolkata
CYCLE_CUTOFF_DAY=22
CYCLE_CUTOFF_HOUR=17
CYCLE_CUTOFF_MINUTE=27

# ------------------------------------------------------------------------------
# 6. PAYMENTS (Razorpay)
# ------------------------------------------------------------------------------
PAYMENT_GATEWAY=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
