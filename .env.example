# ==============================================================================
# PACT - Environment Configuration Reference (.env.example)
# Copy this file to .env and fill in real values. NEVER commit .env to Git!
# ==============================================================================

# General
ENVIRONMENT=development
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 1. DATABASE (Aiven PostgreSQL or Local Fallback)
# ------------------------------------------------------------------------------
# Aiven PostgreSQL (Cloud):
# DATABASE_URL=postgresql://avnadmin:<PASSWORD>@<HOST>:<PORT>/defaultdb?sslmode=require
# Local Docker Fallback:
DATABASE_URL=postgresql://pactuser:pactpassword@localhost:5432/pactdb?sslmode=disable

# ------------------------------------------------------------------------------
# 2. EVENT STREAMING (Aiven Apache Kafka or Local Fallback)
# ------------------------------------------------------------------------------
# Aiven Kafka (Cloud - with SSL certs):
# KAFKA_BOOTSTRAP_SERVERS=kafka-<PROJECT>-<ORG>.aivencloud.com:<PORT>
# KAFKA_SECURITY_PROTOCOL=SSL
# KAFKA_SSL_CA_PATH=./certs/ca.pem
# KAFKA_SSL_CERT_PATH=./certs/service.cert
# KAFKA_SSL_KEY_PATH=./certs/service.key

# Aiven Kafka (Cloud - SASL/SCRAM alternative):
# KAFKA_BOOTSTRAP_SERVERS=kafka-<PROJECT>-<ORG>.aivencloud.com:<PORT>
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM=SCRAM-SHA-256
# KAFKA_SASL_USERNAME=avnadmin
# KAFKA_SASL_PASSWORD=<PASSWORD>

# Local Docker Fallback:
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_TEST_TOPIC=pact-healthcheck-topic

# ------------------------------------------------------------------------------
# 3. SEARCH ENGINE (Aiven OpenSearch or Local Fallback)
# ------------------------------------------------------------------------------
# Aiven OpenSearch (Cloud):
# OPENSEARCH_URL=https://avnadmin:<PASSWORD>@opensearch-<PROJECT>-<ORG>.aivencloud.com:<PORT>
# OPENSEARCH_USE_SSL=true

# Local Docker Fallback:
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USE_SSL=false

# ------------------------------------------------------------------------------
# 4. BACKEND API & AUTHENTICATION
# ------------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change-this-to-a-secure-random-secret-for-jwt

# ------------------------------------------------------------------------------
# 5. FRONTEND CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
