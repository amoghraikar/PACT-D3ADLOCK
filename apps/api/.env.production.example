# ==============================================================================
# PACT - Production Environment Configuration Reference (.env.production.example)
# Use for Render Web Service, Render Background Workers, and Production Deployments.
# ==============================================================================

# Core Application
ENVIRONMENT=production
LOG_LEVEL=INFO
PROJECT_NAME="PACT API"
API_PREFIX=/api/v1

# ------------------------------------------------------------------------------
# 1. DATABASE (Render Managed PostgreSQL 16)
# ------------------------------------------------------------------------------
# In Render, use the internal database connection string:
# postgresql+psycopg://pactuser:<password>@dpg-<id>-a.oregon-postgres.render.com/pact_prod
DATABASE_URL=postgresql+psycopg://pactuser:YOUR_RENDER_DB_PASSWORD@dpg-xxxxxx-a:5432/pact_prod
RUN_MIGRATIONS=true
SEED_ON_STARTUP=false

# ------------------------------------------------------------------------------
# 2. SECURITY & AUTH
# ------------------------------------------------------------------------------
# Minimum 32-character high-entropy secret
APP_SECRET=REPLACE_WITH_HIGH_ENTROPY_RANDOM_SECRET_KEY_MIN_32_BYTES
SESSION_COOKIE_NAME=pact_session
SESSION_MAX_AGE_DAYS=7
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=none
OTP_MODE=production
OTP_EXPIRE_SECONDS=600
OTP_MAX_ATTEMPTS=3
OTP_RATE_LIMIT_COOLDOWN_SECONDS=60
OTP_RATE_LIMIT_MAX_PER_HOUR=5

# ------------------------------------------------------------------------------
# 3. CORS & FRONTEND ORIGINS
# ------------------------------------------------------------------------------
# Render Static Site URL or Custom Domain
FRONTEND_URL=https://pact-web.onrender.com
# Additional allowed origins (e.g. custom domain, capacitor mobile)
EXTRA_ORIGINS="https://pact.collective,capacitor://localhost,http://localhost,https://localhost"

# ------------------------------------------------------------------------------
# 4. BUSINESS CYCLE ENGINE (Asia/Kolkata)
# ------------------------------------------------------------------------------
BUSINESS_TZ=Asia/Kolkata
CYCLE_CUTOFF_DAY=22
CYCLE_CUTOFF_HOUR=17
CYCLE_CUTOFF_MINUTE=27

# ------------------------------------------------------------------------------
# 5. PAYMENTS (Razorpay Production / Live Mode)
# ------------------------------------------------------------------------------
PAYMENT_GATEWAY=razorpay
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=YOUR_LIVE_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_LIVE_RAZORPAY_WEBHOOK_SECRET

# ------------------------------------------------------------------------------
# 6. APACHE KAFKA (Aiven Kafka Managed Cluster)
# ------------------------------------------------------------------------------
EVENT_TRANSPORT=kafka
KAFKA_BOOTSTRAP_SERVERS=kafka-pact-prod.aivencloud.com:12345
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
KAFKA_SASL_USERNAME=pact_kafka_admin
KAFKA_SASL_PASSWORD=YOUR_AIVEN_KAFKA_PASSWORD
KAFKA_CONSUMER_GROUP=pact-production-group
KAFKA_TOPIC_PREFIX=pact
